{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/pre-tool/file-guard.sh"
          },
          {
            "type": "command",
            "command": "./scripts/hooks/pre-tool/inject-lang-standard.sh"
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/pre-tool/bash-guard.sh"
          },
          {
            "type": "command",
            "command": "./scripts/hooks/pre-tool/git-guard.sh"
          }
        ]
      },
      {
        "matcher": "view_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/pre-tool/read-once.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/post-tool/validate-format.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/hooks/session-close/cleanup-session.sh"
          }
        ]
      }
    ]
  }
}
