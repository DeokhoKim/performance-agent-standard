{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|create_file|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/enable-md-writing-rule.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|create_file|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/validate-format.sh"
          }
        ]
      }
    ]
  }
}
